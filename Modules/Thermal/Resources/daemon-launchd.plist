<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.meridian.thermal.daemon</string>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ProgramArguments</key>
	<array>
		<string>@DAEMON_PATH@</string>
		<string>@CONTROL_FILE@</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/tmp/fancontrollab-daemon.log</string>
</dict>
</plist>
